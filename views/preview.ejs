        const del_list_btn = document.querySelector('.del_list_btn');
        const feedback_form = document.querySelector('#feedback_form');
        const feedback_del_btn = document.querySelectorAll('.feedback_del_btn');

        feedback_del_btn.forEach((ele) => {
            ele.addEventListener('click', async (e) => {
                e.preventDefault();
                console.log('Feedback btn clicked', e.currentTarget.id);

                let response = await fetch(`/listings/${consPreData._id}/reviews/${e.currentTarget.id}?originalUrl=/listings/${consPreData._id}`, {
                    method: 'DELETE',
                    headers: {
                        'content-type': 'application/x-www-form-urlencoded',
                        Accept: 'application/json'
                    }
                });

                let responseData = await response.json();

                if (response.ok) {
                    alert(`feedback ${responseData.id} deleted successfully`);
                    window.location.href = `/listings/${consPreData._id}`;
                }

                if (response.status === 401) {
                    alert(responseData.message || "Delete failed");
                    window.location.href = `/login`;
                }


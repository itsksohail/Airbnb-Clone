<% layout('./layouts/boilerplate_preview.ejs') %>
<script>
    let mapBoxApi = "<%= process.env.MAPBOX_API_TOKEN %>";
    let consPreData = <%- JSON.stringify(data) %>;
</script>
    <body>
        <div class="pre_body_holder">
            <div class="pre_header">
                <div>
                    <button class="bk_btn" onclick="back_btn()"><i class="fa-solid fa-circle-arrow-left"></i></button>
                </div>
            </div>
            <div class="pre_body">
                <h1 class="pre_h1">
                    <%= data.title %>
                </h1>
                <img src=<%=optImg %> alt="villa_image">
                <h3>&#8377; <%= data.price.toLocaleString('en-IN') %>
                </h3>
                <h5>Owned by <%= data.owner[0].username %>
                </h5>
                <h3>
                    <%= data.location %>
                        <%= data.country %>
                </h3>
                <p>
                    <%= data.description %>
                </p>
                <% if(currUser && data.owner[0]._id.equals(currUser._id)) { %>
                    <div class="btns_div">
                        <div>
                            <button class="edit_list_btn btn btn-info">Edit</button>
                        </div>
                        <div>
                            <button class="del_list_btn btn btn-warning">Delete</button>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
        <div class="row">
            <div class="col-6 offset-3">
                <h5>Here you'll be</h3>
                <div id="map"></div>
            </div>
        </div>
        <div class="feedback_container mb-5">
            <% if(currUser && (!data.owner[0]._id.equals(currUser._id))){ %>
                <div class="feedback_body">
                    <h5>Leave your feedback</h5>
                    <br>
                    <form action="/listings/<%= data._id %>/reviews?originalUrl=/listings/<%= data._id %>" method="post"
                        enctype="application/x-www-form-urlencoded" class="needs-validation" id="feedback_form"
                        novalidate>
                        <div class="star_container mb-3">
                            <input type="radio" id="s_radio_5_id" name="s_radio_name" value="5">
                            <label for="s_radio_5_id" class="fa-solid fa-star"></label>
                            <input type="radio" id="s_radio_4_id" name="s_radio_name" value="4">
                            <label for="s_radio_4_id" class="fa-solid fa-star"></label>
                            <input type="radio" id="s_radio_3_id" name="s_radio_name" value="3">
                            <label for="s_radio_3_id" class="fa-solid fa-star"></label>
                            <input type="radio" id="s_radio_2_id" name="s_radio_name" value="2">
                            <label for="s_radio_2_id" class="fa-solid fa-star"></label>
                            <input type="radio" id="s_radio_1_id" name="s_radio_name" value="1">
                            <label for="s_radio_1_id" class="fa-solid fa-star"></label>
                        </div>
                        <div class="comment_container mb-3">
                            <textarea name="feedback_comment_name" id="" rows="5" cols="14" class="form-control"
                                required>Enter your feedback...</textarea>
                            <div class="invalid-feedback">Feedback required</div>
                        </div>
                        <button type="submit" class="btn btn-dark">Submit</button>
                    </form>
                </div>
            <% } %>
            <% if(data.feedbacks.length) {%>
                <div class="feedback_footer">
                    <hr>
                    <h5>All Reviews</h5>
                    <br>
                    <div class="row">
                        <% if(data.feedbacks.length){ %>
                            <% for(feeds of data.feedbacks){ %>
                                <div class="card col-5 ms-5 mb-3">
                                    <div class="card-body">
                                        <div class="card-title">
                                            <span>
                                                <i class="fa-solid fa-circle-user"></i>
                                            </span>
                                                @<%= feeds.feedback_author[0].username %>
                                        </div>
                                        <div class="card-text">
                                            <%= feeds.feedback_comment %>
                                        </div>
                                        <div class="card-text">
                                            <% if(feeds.star_point==1){ %>
                                                <span><i class="fa-solid fa-star"></i></span>
                                                    <% }else if(feeds.star_point==2){ %>
                                                        <span><i class="fa-solid fa-star"></i></span>
                                                        <span><i class="fa-solid fa-star"></i></span>
                                                        <% }else if(feeds.star_point==3){ %>
                                                            <span><i class="fa-solid fa-star"></i></span>
                                                            <span><i class="fa-solid fa-star"></i></span>
                                                            <span><i class="fa-solid fa-star"></i></span>
                                                            <% }else if(feeds.star_point==4){ %>
                                                                <span><i class="fa-solid fa-star"></i></span>
                                                                <span><i class="fa-solid fa-star"></i></span>
                                                                <span><i class="fa-solid fa-star"></i></span>
                                                                <span><i class="fa-solid fa-star"></i></span>
                                                                <% }else if(feeds.star_point==5){ %>
                                                                    <span><i class="fa-solid fa-star"></i></span>
                                                                    <span><i class="fa-solid fa-star"></i></span>
                                                                    <span><i class="fa-solid fa-star"></i></span>
                                                                    <span><i class="fa-solid fa-star"></i></span>
                                                                    <span><i class="fa-solid fa-star"></i></span>
                                                                <% } %>
                                        </div>
                                        <% if(currUser && feeds.feedback_author[0]._id.equals(currUser._id)){ %>
                                            <button class="feedback_del_btn btn btn-dark mb-2 btn-sm"
                                                style="width: 5em; position: relative; left: 190px;"
                                                id="<%= feeds._id %>">Delete</button>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </body>
    <script src="/script/mapbox_script.js">
        console.log(data.geocode.coordinates);
    </script>
    <script defer>

        const edit_list_btn = document.querySelector('.edit_list_btn');

<% layout('./layouts/boilerplate_preview.ejs') %>

    <body>
        <div class="form_holder_list">
            <div class="form_header">
                <div>
                    <h2 class="form_head_title">Add Villa / Apartment / Flat</h2>
                </div>
                <div>
                    <button class="close_cls btn btn-danger">X</button>
                </div>
            </div>
            <div class="form_body">
                <form class="form_list needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="title_id" class="form-label">Title</label>
                        <input type="text" name="title_name" id="title_id" value="" class="form-control" required>
                        <div class="valid-feedback">Title look's good!</div>
                        <div class="invalid-feedback">Title should be valid.</div>
                    </div>
                    <div class="mb-3">
                        <label for="desc_id" class="form-label">Description</label>
                        <textarea name="desc_name" id="desc_id" rows="3" cols="40" class="form-control"
                            required></textarea>
                        <div class="valid-feedback">Catchy Description!</div>
                        <div class="invalid-feedback">Description should be valid</div>
                    </div>
                    <div class="mb-3">
                        <label for="img_id" class="form-label">Image</label>
                        <div class="image_preview_div_n">
                            <img src="" alt="villa_img" width="400px" height="200px" class="img_pre">
                        </div>
                        <input type="file" name="img_name" id="img_id" accept="image/*" class="form-control">
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6">
                            <label for="price_id" class="form-label">Price</label>
                            <input type="number" name="price_name" id="price_id" value="" class="form-control" required>
                            <div class="valid-feedback">Price looks good!</div>
                            <div class="invalid-feedback">Price should be valid.</div>
                        </div>
                        <div class="mb-3 col-6">
                            <label for="location_id" class="form-label">Location</label>
                            <input type="text" name="location_name" id="location_id" class="form-control" required>
                            <div class="valid-feedback">Location looks good!</div>
                            <div class="invalid-feedback">Location should be valid.</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="country_id" class="form-label">Country</label>
                        <select name="country_name" id="country_id" class="form-select" required>
                            <option value="">None</option>
                            <option value="India">India</option>
                            <option value="Afghanistan">Afghanistan</option>
                            <option value="Albania">Albania</option>
                            <option value="Algeria">Algeria</option>
                            <option value="Andorra">Andorra</option>
                            <option value="Angola">Angola</option>
                            <option value="Argentina">Argentina</option>
                            <option value="Armenia">Armenia</option>
                            <option value="Australia">Australia</option>
                            <option value="Austria">Austria</option>
                            <option value="Azerbaijan">Azerbaijan</option>
                            <option value="Bahamas">Bahamas</option>
                            <option value="Bahrain">Bahrain</option>
                            <option value="Bangladesh">Bangladesh</option>
                        </select>
                        <div class="valid-feedback">Country is valid!</div>
                        <div class="invalid-feedback">Country should be valid.</div>
                    </div>
                    <div class="mb-3">
                        <label for="category_id" class="form-label">Category</label>
                        <select name="category_name" id="category_id" class="form-select" required>
                            <option value="">None</option>
                            <option value="Trending">Trending</option>
                            <option value="Rooms">Rooms</option>
                            <option value="Iconic Cities">Iconic Cities</option>
                            <option value="Mountains</">Mountains</option>
                            <option value="Castles</">Castles</option>
                            <option value="Amazing Pools">Amazing Pools</option>
                            <option value="Camping</">Camping</option>
                            <option value="Farms</">Farms</option>
                            <option value="Arctic</">Arctic</option>
                        </select>
                    </div>
                    <button class="btn btn-dark" type="submit">Submit</button>
                </form>
            </div>
        </div>
    </body>
    <script>
        const form_list = document.querySelector('.form_list');
        const close_cls_btn = document.querySelector('.close_cls');
        const img_id = document.querySelector('#img_id');
        const img_pre = document.querySelector('.img_pre');
        const image_preview_div = document.querySelector('.image_preview_div_n');

        close_cls_btn.addEventListener('click', () => {
            window.location.href = '/home';
        });

        img_id.addEventListener('change', (e) => {
            let file = e.target.files[0];
            if (!file) return;
            let readObj = new FileReader();
            readObj.onload = e => {
                img_pre.src = e.target.result;
                image_preview_div.classList.remove('.image_preview_div_n');
                image_preview_div.classList.add('image_preview_div_b');
            };
            readObj.readAsDataURL(file);
        });

        form_list.addEventListener('submit', async (e) => {
            e.preventDefault();


            // if (e.currentTarget.checkValidity()) {
                let pb = confirm('Do you want to proceed with new listing?');

                if (pb) {

                    const formData = new FormData(e.target);

                        let response = await fetch('listings/submit_list?originalUrl=/create_new_listing', {
                            method: 'POST',
                            headers: {
                                Accept: 'application/json'
                            },
                            body: formData
                        });

                        
                        if (response.ok) {
                            alert('Listing created successfully');
                            window.location.href = '/home';
                        }else {
                            alert('Listing upload failed');
                            window.location.href = '/home'
                        }

                        if(response.status === 401){
                            let responseData = await response.json();
                            alert(responseData.message || 'Connection failed');
                            window.location.href = '/login'
                        }

                        // let errorHtml = await response.text();
                        //     document.open();
                        //     document.write(errorHtml);
                        //     document.close();
                }
            // }
        });

    </script>
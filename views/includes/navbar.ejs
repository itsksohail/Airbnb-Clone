<script>
    const taxSwitch = document.querySelector('.tax_switch');
    const filterNavClick = document.querySelectorAll('.filterNavClick');
    const search_form = document.querySelector('.search_form');

    taxSwitch.addEventListener('click', (e) => {

        let showTax = document.querySelectorAll('.showTax');

        for (tax of showTax) {
            if (tax.style.display === 'none' || tax.style.display === '') {
                tax.style.display = 'inline';
            } else {
                tax.style.display = 'none';
            }
        }

    });

    filterNavClick.forEach((e) => {
        e.addEventListener('click', (e)=>{
            // console.log(e.currentTarget.id);
            window.location.href = `/listings/filter/${e.currentTarget.id}`;
        });
    })

    search_form.addEventListener('submit', (e)=>{
        e.preventDefault();
        let input_field = e.target.querySelector('.search_field');
        console.log(input_field.value);
        window.location.href = `/listings/find/search?q=${input_field.value}`;
    })

</script>